{
    "compileOnSave": true,
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "lib": ["esnext", "dom"],
        "module": "esnext",
        "moduleResolution": "node",
        "noResolve": false,
        "outDir": "./build",
        "removeComments": true,
        "sourceMap": false,
        "target": "es5"
    },
    "exclude": ["./node_modules"],
    "include": ["./src", "./tests", "./example", "**.js"],
    "typeRoots": ["./node_modules/@types", "./src"]
}