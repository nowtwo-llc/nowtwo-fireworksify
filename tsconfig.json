{
    "compileOnSave": true,
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "declarationMap": true,
        "lib": ["es2018", "dom"],
        "module": "es2015",
        "moduleResolution": "node",
        "noImplicitAny": true,
        "noResolve": false,
        "outDir": "dist",
        "removeComments": true,
        "sourceMap": true,
        "target": "es5"
    },
    "exclude": ["./node_modules"],
    "include": ["./src", "./tests", "./example", "**.js"],
    "typeRoots": ["./node_modules/@types", "./src"]
}